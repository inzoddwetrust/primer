{
  "$defs": {
    "Accepted": {
      "additionalProperties": false,
      "description": "A kind of the product's data a service takes (protocol 4.5, 4.7):\n``validate`` -- its command, ``<dir>`` the data's path in the container;\n``env`` -- the variable the machine gives that path under.",
      "properties": {
        "env": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        },
        "validate": {
          "minLength": 1,
          "title": "Validate",
          "type": "string"
        }
      },
      "required": [
        "validate",
        "env"
      ],
      "title": "Accepted",
      "type": "object"
    },
    "Address": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "address",
          "title": "Source",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Address",
      "type": "object"
    },
    "App": {
      "additionalProperties": false,
      "properties": {
        "health": {
          "pattern": "^/[A-Za-z0-9._~/-]*$",
          "title": "Health",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "ready": {
          "pattern": "^/[A-Za-z0-9._~/-]*$",
          "title": "Ready",
          "type": "string"
        },
        "service": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "port",
        "health",
        "ready"
      ],
      "title": "App",
      "type": "object"
    },
    "Asked": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "asked",
          "title": "Source",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Asked",
      "type": "object"
    },
    "BuildPlace": {
      "additionalProperties": false,
      "description": "Where ``apply: build`` puts a package: ``path`` inside the build context\nof ``service`` (rule 10, the owner's decision of 02.11).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "service": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "path"
      ],
      "title": "BuildPlace",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "description": "``data`` -- the form D of protocol 4.5: a directory of the product's\nrepository, by kind, copied to the service, which ``accepts`` that kind.",
      "properties": {
        "data": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "type": "string"
            }
          },
          "title": "Data",
          "type": "object"
        },
        "repo": {
          "minLength": 1,
          "title": "Repo",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "version"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Derived": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "source": {
          "const": "derived",
          "title": "Source",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "source",
        "run"
      ],
      "title": "Derived",
      "type": "object"
    },
    "Edition": {
      "additionalProperties": false,
      "properties": {
        "services": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "services"
      ],
      "title": "Edition",
      "type": "object"
    },
    "EgressWhen": {
      "additionalProperties": false,
      "description": "A host of ``egress`` open when one of its options is on (rule 40).",
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "when": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "When",
          "type": "array"
        }
      },
      "required": [
        "host",
        "when"
      ],
      "title": "EgressWhen",
      "type": "object"
    },
    "Frontend": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "service": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "port"
      ],
      "title": "Frontend",
      "type": "object"
    },
    "Headers": {
      "additionalProperties": false,
      "properties": {
        "csp": {
          "minLength": 1,
          "title": "Csp",
          "type": "string"
        }
      },
      "title": "Headers",
      "type": "object"
    },
    "HostPort": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "proto": {
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Proto",
          "type": "string"
        }
      },
      "required": [
        "proto",
        "port"
      ],
      "title": "HostPort",
      "type": "object"
    },
    "Minted": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "minted",
          "title": "Source",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Minted",
      "type": "object"
    },
    "Mount": {
      "additionalProperties": false,
      "description": "Checked as a whole by rule 10 in the rule layer.",
      "properties": {
        "dependency": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Dependency",
          "type": "string"
        },
        "env": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "service": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Service",
          "type": "string"
        }
      },
      "title": "Mount",
      "type": "object"
    },
    "Package": {
      "additionalProperties": false,
      "description": "Checked as a whole by rule 10 in the rule layer: ``apply: runtime``\nmounts (``mount``, ``validate``), ``apply: build`` builds (``build``).",
      "properties": {
        "apply": {
          "default": "runtime",
          "enum": [
            "runtime",
            "build"
          ],
          "title": "Apply",
          "type": "string"
        },
        "build": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BuildPlace"
          },
          "title": "Build",
          "type": "array"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "mount": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Mount"
          },
          "title": "Mount",
          "type": "array"
        },
        "validate": {
          "minLength": 1,
          "title": "Validate",
          "type": "string"
        }
      },
      "required": [
        "contract"
      ],
      "title": "Package",
      "type": "object"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "param",
          "title": "Source",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Param",
      "type": "object"
    },
    "Passport": {
      "additionalProperties": false,
      "properties": {
        "enum": {
          "const": "editions",
          "title": "Enum",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "source": {
          "const": "passport",
          "title": "Source",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "source",
        "key"
      ],
      "title": "Passport",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "$ref": "#/$defs/Dependency"
            }
          },
          "title": "Dependencies",
          "type": "object"
        },
        "editions": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "$ref": "#/$defs/Edition"
            }
          },
          "title": "Editions",
          "type": "object"
        },
        "egress": {
          "default": [],
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/EgressWhen"
              }
            ]
          },
          "title": "Egress",
          "type": "array"
        },
        "env": {
          "default": {},
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "discriminator": {
                "mapping": {
                  "address": "#/$defs/Address",
                  "asked": "#/$defs/Asked",
                  "derived": "#/$defs/Derived",
                  "minted": "#/$defs/Minted",
                  "param": "#/$defs/Param",
                  "passport": "#/$defs/Passport",
                  "seam": "#/$defs/Seam"
                },
                "propertyName": "source"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Minted"
                },
                {
                  "$ref": "#/$defs/Asked"
                },
                {
                  "$ref": "#/$defs/Derived"
                },
                {
                  "$ref": "#/$defs/Param"
                },
                {
                  "$ref": "#/$defs/Passport"
                },
                {
                  "$ref": "#/$defs/Seam"
                },
                {
                  "$ref": "#/$defs/Address"
                }
              ]
            }
          },
          "title": "Env",
          "type": "object"
        },
        "host": {
          "$ref": "#/$defs/ProductHost"
        },
        "kind": {
          "const": "product",
          "title": "Kind",
          "type": "string"
        },
        "languages": {
          "items": {
            "pattern": "^[a-z]{2,3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "options_required": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options Required",
          "type": "array"
        },
        "packages": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "$ref": "#/$defs/Package"
            }
          },
          "title": "Packages",
          "type": "object"
        },
        "provides": {
          "default": {},
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProvideUrl"
                },
                {
                  "$ref": "#/$defs/ProvideVerb"
                }
              ]
            }
          },
          "title": "Provides",
          "type": "object"
        },
        "replay": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Replay",
          "type": "object"
        },
        "report": {
          "$ref": "#/$defs/Report"
        },
        "schema": {
          "const": 1,
          "title": "Schema",
          "type": "integer"
        },
        "stacks": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "$ref": "#/$defs/Stack"
            }
          },
          "title": "Stacks",
          "type": "object"
        },
        "verbs": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "$ref": "#/$defs/Verb"
            }
          },
          "title": "Verbs",
          "type": "object"
        }
      },
      "required": [
        "schema",
        "name",
        "stacks",
        "report",
        "kind"
      ],
      "title": "Product",
      "type": "object"
    },
    "ProductHost": {
      "additionalProperties": false,
