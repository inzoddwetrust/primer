          "pattern": "^/[A-Za-z0-9._~/-]*$",
          "title": "Health",
          "type": "string"
        },
        "junit": {
          "title": "Junit",
          "type": "boolean"
        },
        "logs": {
          "const": "json",
          "title": "Logs",
          "type": "string"
        },
        "ready": {
          "pattern": "^/[A-Za-z0-9._~/-]*$",
          "title": "Ready",
          "type": "string"
        }
      },
      "required": [
