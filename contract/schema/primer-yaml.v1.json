          "title": "Env",
          "type": "object"
        },
        "host": {
          "$ref": "#/$defs/ServiceHost"
        },
        "kind": {
          "const": "service",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
