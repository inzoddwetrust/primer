        },
        "routes": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,62}$": {
              "$ref": "#/$defs/Route"
            }
          },
          "title": "Routes",
          "type": "object"
        }
      },
      "title": "ProductHost",
      "type": "object"
    },
    "ProvideUrl": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
