        },
        "frontend": {
          "$ref": "#/$defs/Frontend"
        },
        "migrate": {
          "minLength": 1,
          "title": "Migrate",
          "type": "string"
        },
        "persistent": {
          "default": false,
          "title": "Persistent",
          "type": "boolean"
