          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "AfterInterrupt",
      "type": "object"
    },
    "CommandFailedReason": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "code": {
          "const": "command-failed",
          "title": "Code",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "argv",
        "exit_code"
      ],
      "title": "CommandFailedReason",
      "type": "object"
    },
    "CommandNotStartedReason": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "code": {
          "const": "command-not-started",
          "title": "Code",
          "type": "string"
        },
        "errno": {
          "anyOf": [
            {
              "pattern": "^E[A-Z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Errno"
        }
      },
      "required": [
        "code",
        "argv",
        "errno"
      ],
      "title": "CommandNotStartedReason",
      "type": "object"
    },
    "CommandTimedOutReason": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "code": {
          "const": "command-timed-out",
          "title": "Code",
          "type": "string"
        },
        "timeout_s": {
          "minimum": 0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "code",
        "argv",
        "timeout_s"
      ],
      "title": "CommandTimedOutReason",
      "type": "object"
    },
    "DnsCheck": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "resolves_to": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Resolves To",
          "type": "array"
        }
      },
      "required": [
        "domain",
        "resolves_to",
        "expected"
      ],
      "title": "DnsCheck",
      "type": "object"
    },
    "DoctorDiff": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "description": "What ``doctor`` found a step would do: ``name`` is the step of ``code``.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9-]*$",
          "title": "Code",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "stack": {
          "minLength": 1,
          "title": "Stack",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stack",
        "name"
      ],
      "title": "DoctorDiff",
      "type": "object"
    },
    "ExceptionReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "exception",
          "title": "Code",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code",
        "type"
      ],
      "title": "ExceptionReason",
      "type": "object"
    },
    "ExitCode": {
      "description": "Exit code of a pridem command.",
      "enum": [
        0,
        1,
        2
      ],
      "title": "ExitCode",
      "type": "integer"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Request Ids",
          "type": "array"
        },
        "test": {
          "minLength": 1,
          "title": "Test",
          "type": "string"
        },
        "traceback_project_frames": {
          "items": {
            "type": "string"
          },
          "title": "Traceback Project Frames",
          "type": "array"
        }
      },
      "required": [
        "test",
        "file",
        "line",
        "message",
        "traceback_project_frames",
        "request_ids"
      ],
      "title": "Failure",
      "type": "object"
    },
    "Interrupted": {
