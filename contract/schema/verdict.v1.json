{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "on_behalf_of": {
          "minLength": 1,
          "title": "On Behalf Of",
          "type": "string"
        },
        "type": {
          "enum": [
            "owner",
            "engineer",
            "dispatcher",
            "executor",
            "machine"
          ],
          "title": "Type",
          "type": "string"
        },
        "via": {
          "enum": [
            "local",
            "panel",
            "timer"
          ],
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "type",
        "via"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AfterFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "after-failure",
          "title": "Code",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "phase": {
          "enum": [
            "main",
            "restore",
            "finally"
          ],
          "title": "Phase",
          "type": "string"
        },
        "stack": {
          "minLength": 1,
          "title": "Stack",
          "type": "string"
        }
      },
      "required": [
        "code",
        "phase",
        "stack",
        "name"
      ],
      "title": "AfterFailure",
      "type": "object"
    },
    "AfterInterrupt": {
      "additionalProperties": false,
      "properties": {
        "code": {
