          "const": "restore",
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "code"
      ],
      "title": "RestoreNeeded",
      "type": "object"
    },
    "RoleSkip": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "role",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "code",
        "role"
      ],
      "title": "RoleSkip",
