          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "what": {
          "const": "run",
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "code",
        "line"
      ],
      "title": "JournalDamaged",
      "type": "object"
    },
    "JournalQuarantined": {
      "additionalProperties": false,
