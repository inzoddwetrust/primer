          "type": "string"
        },
        "what": {
          "const": "journal",
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "code",
        "run_id"
      ],
      "title": "JournalQuarantined",
      "type": "object"
    },
    "JournalWriteFailed": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "write-failed",
          "title": "Code",
          "type": "string"
        },
        "what": {
          "const": "journal",
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "code"
      ],
      "title": "JournalWriteFailed",
      "type": "object"
    },
    "Json": {
      "anyOf": [
        {
          "type": "boolean"
