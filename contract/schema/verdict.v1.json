        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/Json"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          },
          "type": "object"
        }
      ]
    },
    "Junit": {
      "additionalProperties": false,
