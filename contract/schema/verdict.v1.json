          "anyOf": [
            {
              "additionalProperties": false,
              "description": "A step of a plan: where a journal ends.",
              "properties": {
                "name": {
                  "minLength": 1,
                  "title": "Name",
                  "type": "string"
                },
                "phase": {
                  "enum": [
                    "main",
                    "restore",
                    "finally"
                  ],
                  "title": "Phase",
                  "type": "string"
                },
                "stack": {
                  "minLength": 1,
                  "title": "Stack",
                  "type": "string"
                }
              },
              "required": [
                "phase",
                "stack",
                "name"
              ],
              "title": "At",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "what": {
          "const": "run",
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "code",
        "ended_at"
      ],
      "title": "NoVerdict",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "items": {
            "$ref": "#/$defs/DnsCheck"
          },
          "title": "Dns",
          "type": "array"
        },
        "doctor_diff": {
          "items": {
            "$ref": "#/$defs/DoctorDiff"
          },
          "title": "Doctor Diff",
          "type": "array"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/Failure"
          },
          "title": "Failures",
          "type": "array"
        },
        "incomplete": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/NoVerdict"
              },
              {
                "$ref": "#/$defs/JournalDamaged"
              },
              {
                "$ref": "#/$defs/JournalWriteFailed"
              },
              {
                "$ref": "#/$defs/JournalQuarantined"
              },
              {
                "$ref": "#/$defs/StateQuarantined"
              },
              {
                "$ref": "#/$defs/RestoreNeeded"
              },
              {
                "$ref": "#/$defs/StepIncomplete"
              }
            ]
          },
          "title": "Incomplete",
          "type": "array"
        }
      },
      "required": [
        "failures",
        "incomplete"
      ],
      "title": "Report",
      "type": "object"
    },
    "RestoreNeeded": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "needed",
          "title": "Code",
          "type": "string"
